# ─── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Optional: email digest ────────────────────────────────────────────────────
# If not set, the HTML digest is only saved locally (open it in any browser).
EMAIL_FROM=you@gmail.com
EMAIL_TO=you@gmail.com
EMAIL_PASSWORD=your-gmail-app-password   # Use Gmail App Password, not your login password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587

# ─── Optional: schedule time ──────────────────────────────────────────────────
# HH:MM in 24h format. Default: 06:00
DAILY_RUN_TIME=06:00
